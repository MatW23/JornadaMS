JORNADA_MS_ENVIRONMENT=development
JORNADA_MS_DEBUG=false
JORNADA_MS_DATABASE_URL=sqlite+pysqlite:///./jornada-dev.db
JORNADA_MS_DATABASE_ECHO=false
JORNADA_MS_ACCESS_TOKEN_EXPIRE_SECONDS=900
JORNADA_MS_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
JORNADA_MS_LOGIN_RATE_LIMIT_ATTEMPTS=5
JORNADA_MS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
JORNADA_MS_ACCESS_COOKIE_NAME=jornada_access
JORNADA_MS_REFRESH_COOKIE_NAME=jornada_refresh
# Use true behind HTTPS. Production environments force Secure cookies automatically.
JORNADA_MS_AUTH_COOKIE_SECURE=false
JORNADA_MS_JWT_SECRET=development-only-change-this-jwt-secret-32-chars
JORNADA_MS_JWT_ISSUER=jornada-ms
JORNADA_MS_JWT_AUDIENCE=jornada-ms-web
